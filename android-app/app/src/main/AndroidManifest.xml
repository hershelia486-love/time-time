<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:allowBackup="true" android:icon="@drawable/ic_compass" android:label="Time Tipping Compass" android:supportsRtl="true" android:theme="@style/Theme.TimeTippingCompass">
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".TodayRoutineWidgetProvider" android:exported="false" android:label="오늘 루틴">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/today_routine_widget_info" />
        </receiver>
    </application>
</manifest>
